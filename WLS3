local PET_PRIORITY = { "Roboto", "Sarge" }
local PET_PRICE = { ["Roboto"] = 10000, ["Sarge"] = 7500, ["Krafty Karly"] = 3000, ["Pookins"] = 2000, ["Flash"] = 5000, ["Corrupted Skull"] = 8000 }

local function ownedPets()
	local set = {}
	if plrPets then
		for _, c in ipairs(plrPets:GetChildren()) do
			set[c.Name] = true
		end
	end
	return set
end

local function equipPet(name)
	local ok, res = pcall(function()
		return buyPetRemote:InvokeServer(name, "equipPet")
	end)
	return ok and res == true
end

local function buyPet(name)
	pcall(function()
		buyPetRemote:InvokeServer(name, "buyPet")
	end)
end

local function unequipPet(name)
	pcall(function()
		buyPetRemote:InvokeServer(name, "unequipPet")
	end)
end

local function rebirthPet(name)
	pcall(function()
		buyPetRemote:InvokeServer(name, "rebirthPet")
	end)
end

task.spawn(function()
	while STATE.alive() do
		task.wait(10)
		if autoPet then
			local owned = ownedPets()
			local best = nil
			for _, pet in ipairs(PET_PRIORITY) do
				if owned[pet] then
					best = pet
					break
				end
			end
			if not best then
				for _, pet in ipairs(PET_PRIORITY) do
					if (gems.Value or 0) >= (PET_PRICE[pet] or math.huge) then
						buyPet(pet)
						if equipPet(pet) then
							best = pet
						end
						break
					end
				end
			end
			if best and equippedPet.Value ~= best then
				equipPet(best)
			end
		end
	end
end)

