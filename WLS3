-- ================= AUTO KILL ALL =================
local function equippedCombat()
	return LP.Character and LP.Character:FindFirstChild("Combat")
end

local function ensureCombat()
	local tool = equippedCombat()
	if tool then
		return tool
	end
	tool = LP.Backpack:FindFirstChild("Combat")
	if tool and LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") then
		pcall(function()
			LP.Character:FindFirstChildOfClass("Humanoid"):EquipTool(tool)
		end)
		task.wait(0.12)
		tool = equippedCombat()
	end
	return tool
end

local function aliveTargets()
	local t = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP then
			local ch = p.Character
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
			if hum and hrp and hum.Health > 0 then
				table.insert(t, p)
			end
		end
	end
	return t
end

-- TP point blank sur la cible + spam Combat:Activate jusqu'a sa mort
local function tryKillTarget(p)
	local ch = p.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not (hrp and hum) or hum.Health <= 0 then
		return false
	end
	local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	local tool = ensureCombat()
	if not (root and tool) then
		return false
	end
	local deadline = os.clock() + 7
	local hitCount = 0
	while STATE.alive() and os.clock() < deadline do
		if not hum.Parent or hum.Health <= 0 then
			break
		end
		if not root.Parent then
			break
		end
		if (root.Position - hrp.Position).Magnitude > 6 then
			pcall(function()
				root.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 3, 2))
			end)
			task.wait(0.1)
		end
		pcall(function()
			tool:Activate()
		end)
		hitCount += 1
		task.wait(0.06)
	end
	local dead = (not hum.Parent) or hum.Health <= 0
	if dead then
		table.insert(killLogLines, 1, ("+ %s tue (coup %d)"):format(p.Name, hitCount))
		if #killLogLines > 8 then
			table.remove(killLogLines)
		end
	end
	return dead
end

local function killCycle()
	pcall(function()
		brawlEvent:FireServer("joinBrawl")
	end)
	ensureCombat()
	local killed = 0
	for _, p in ipairs(aliveTargets()) do
		if STATE.alive() then
			local ok, err = pcall(tryKillTarget, p)
			if not ok then
				warn("BrolyHub: kill err - " .. tostring(err))
			elseif ok then
				-- returned true/false correct
			end
		end
	end
	-- compte les kills gagnes
	local gained = currentKills() - killKillsBefore
	if gained > 0 then
		table.insert(killLogLines, 1, ("+ %d kills gains"):format(gained))
		if #killLogLines > 8 then
			table.remove(killLogLines)
		end
	end
	return true
end

task.spawn(function()
	while STATE.alive() do
		task.wait(0.3)
		if not killOn then
			task.wait(1)
		else
			pcall(killCycle)
		end
	end
end)

