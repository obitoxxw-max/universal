local function fmt(n)
	n = n or 0
	if n >= 1e9 then
		return ("%.2fB"):format(n / 1e9)
	elseif n >= 1e6 then
		return ("%.2fM"):format(n / 1e6)
	elseif n >= 1e3 then
		return ("%.2fK"):format(n / 1e3)
	end
	return tostring(math.floor(n))
end

local function currentKills()
	return killsStat and killsStat.Value or 0
end

