-- ================= INFO LOOP =================
task.spawn(function()
	while STATE.alive() do
		task.wait(1)
		local steps = {
			{ "stats", function()
				statsPara:SetDesc(string.format(
					"Force: %s\nRebirths: %s (multipl. x%s)\nSpeed: %s\nGems: %s\nPet: %s\nToken: %s\nKills: %s\nSafe Zone: altitude %d",
					fmt(strength.Value),
					tostring(rebirths.Value),
					fmt(strMult and strMult.Value or 1),
					fmt(speedStat and speedStat.Value or 0),
					fmt(gems.Value),
					equippedPet.Value ~= "" and equippedPet.Value or "aucun",
					cachedToken and string.sub(cachedToken, 1, 8) .. "..." or "aucun",
					tostring(currentKills()),
					safeZoneHeight
				))
			end },
			{ "farm", function()
				farmPara:SetDesc(string.format(
					"Farm: %s\nValeur: %s | Intervalle: %ss\nDernier gain: +%s\nTaux: ~%s/s\nFires: %d\nSafeZone: %s (altitude %d)",
					farmOn and "ON" or "OFF",
					fmt(farmValue),
					("%.2f"):format(farmInterval),
					fmt(lastGain),
					fmt(rate),
					fireCount,
					safeZoneOn and "ON" or "OFF",
					safeZoneHeight
				))
			end },
			{ "kill", function()
				killPara:SetDesc(string.format(
					"Auto Kill All: %s\nKills session: %s | total: %s\n%s",
					killOn and "ON" or "OFF",
					fmt(math.max(0, currentKills() - killKillsBefore)),
					fmt(currentKills()),
					table.concat(killLogLines, "\n")
				))
			end },
			{ "rebirth", function()
				rebirthPara:SetDesc(string.format(
					"Auto: %s (sans limite)\nRebirths: %s\nRequis: %s\nMultiplicateur: x%s",
					autoRebirth and "ON" or "OFF",
					tostring(rebirths.Value),
					fmt(10000 + (rebirths.Value or 0) * 1000),
					fmt(strMult and strMult.Value or 1)
				))
			end },
			{ "pet", function()
				local owned = {}
				if plrPets then
					for _, c in ipairs(plrPets:GetChildren()) do
						table.insert(owned, c.Name)
					end
				end
				petPara:SetDesc(#owned > 0 and table.concat(owned, ", ") or "Aucun pet possede")
			end },
		}
		for _, step in ipairs(steps) do
			local okU, errU = pcall(step[2])
			if not okU then
				warn("BrolyHub: info step '" .. step[1] .. "' error - " .. tostring(errU))
			end
		end
	end
end)

