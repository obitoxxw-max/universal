-- ================= TOKEN =================
local cachedToken = nil
local repFn = nil
local repRefindAt = 0

STATE.connect(tokenRemote.OnClientEvent, function(...)
	local a = { ... }
	local t = a[1]
	if typeof(t) == "string" then
		cachedToken = t
	elseif type(t) == "table" then
		cachedToken = t[1]
	end
end)

local function refreshToken()
	if not repFn or os.clock() > repRefindAt then
		repFn = filtergc("function", { Name = "repMachine" }, true)
		repRefindAt = os.clock() + 10
	end
	if repFn then
		local t = debug.getupvalue(repFn, 5)
		if typeof(t) == "string" then
			cachedToken = t
		end
	end
	return cachedToken
end

refreshToken()

-- ================= GAIN TRACKERS =================
local lastStrength = strength.Value
local lastGain = 0
local gainTotal = 0
local gainStart = os.clock()
local rate = 0
local fireCount = 0

task.spawn(function()
	while STATE.alive() do
		task.wait(0.5)
		local s = strength.Value
		if s > lastStrength then
			lastGain = s - lastStrength
			gainTotal += lastGain
			fireCount += 1
			rate = gainTotal / math.max(1, os.clock() - gainStart)
			lastStrength = s
		elseif s < lastStrength then
			lastStrength = s
			lastGain = 0
			gainTotal = 0
			gainStart = os.clock()
		end
	end
end)

